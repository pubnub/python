# Copy to tests/live/.env.local and fill in. Never commit .env.local (it is git-ignored).
# Real environment variables win over this file. LIVE_ENV_FILE=<path> reads another file instead.

# Open keyset: no Access Manager. Message Persistence with Delete-From-History, Presence, App Context, Files,
# Mobile Push, Stream Controller with wildcard subscribe.
PUBLISH_KEY=
SUBSCRIBE_KEY=

# Access Manager keyset: Access Manager with token revocation, Message Persistence, Presence.
PAM_PUBLISH_KEY=
PAM_SUBSCRIBE_KEY=
PAM_SECRET_KEY=

# Optional, read only: the preflight reads the keyset features through the Admin API.
PUBNUB_ADMIN_API_KEY=
DOCS_SNIPPETS_OPEN_KEYSET_ID=
DOCS_SNIPPETS_PAM_KEYSET_ID=

# Optional switches: off skips the cleanup or the feature check (single-page runs).
# LIVE_JANITOR=off
# LIVE_PREFLIGHT=off
# LIVE_GROUP=messaging
